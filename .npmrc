# eslint-plugin-jsx-a11y (the accessibility lint guardrail, #3773) hasn't widened its `eslint` peer
# range for ESLint 10 yet — it declares `^3 || … || ^9`, though its AST-based rules run fine on 10.
# Tolerate the stale peer so `npm install` / `npm ci` succeed without a per-command flag. Revisit once
# jsx-a11y ships an ESLint-10 peer range.
legacy-peer-deps=true
