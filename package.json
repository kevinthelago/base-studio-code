{
  "name": "base-studio-code",
  "private": true,
  "version": "1.0.51",
  "type": "module",
  "scripts": {
    "dev": "node scripts/emit-records.mjs && vite",
    "build": "node scripts/emit-records.mjs && node scripts/record-run.mjs --stage typecheck --source npm-build:tsc --project core -- tsc && node scripts/record-run.mjs --stage build --source npm-build:vite --project core -- vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/record-run.mjs --stage launch --source dev:app --project core -- npm run tauri -- dev",
    "app:dev": "bsc app status || true && node scripts/record-run.mjs --stage launch --source app:dev --project core -- npm run tauri -- dev --no-watch",
    "app:status": "bsc app status",
    "build:plan": "bsc disk gc --quiet 2>/dev/null || true && node scripts/record-run.mjs --stage compile --source build:plan --project core -- cargo build --bin bsc --bin bsc-agent --bin bsc-hook && node scripts/verify-build-artifacts.mjs --quiet && node scripts/publish-sidecars.mjs --quiet",
    "rebuild": "bsc app rebuild",
    "promote": "bsc app promote",
    "hooks:install": "bsc app hooks",
    "stage:sidecar": "node scripts/stage-sidecar.mjs",
    "release": "bsc app release",
    "archive": "node scripts/archive-graph.cjs",
    "gate": "node scripts/gate.mjs",
    "gate:full": "node scripts/gate.mjs --full",
    "typecheck": "node scripts/emit-records.mjs && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node scripts/emit-records.mjs && vitest run",
    "test:watch": "node scripts/emit-records.mjs && vitest",
    "test:coverage": "node scripts/emit-records.mjs && vitest run --coverage",
    "fixtures:store": "node scripts/gen-store-fixtures.mjs",
    "test:e2e": "playwright test",
    "profile:glance": "playwright test e2e/glanceProfile.spec.ts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "emit:records": "node scripts/emit-records.mjs",
    "emit:manifests": "node scripts/emit-manifests.mjs",
    "prepare": "node scripts/emit-manifests.mjs",
    "dev-boot-check": "node scripts/dev-boot-check.mjs",
    "bsc:doctor": "b=target/debug/bsc; [ -s \"$b\" ] || b=target/release/bsc; [ -s \"$b\" ] || b=\"$HOME/.base-studio-code/bin/bsc\"; \"$b\" self doctor --root .",
    "diagnose:build": "node scripts/diagnose-build-failure.mjs",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.17.0",
    "d3-force": "^3.0.0",
    "esbuild-wasm": "^0.28.1",
    "lucide-react": "^1.27.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.7"
  }
}
