          "props": [
            { "name": "onClick", "value": "() => {}" },
            { "name": "maxWidth", "value": "window.innerWidth" },
            { "name": "minHeight", "value": "window.innerHeight" },
            { "name": "w", "value": "window.innerWidth" },
            { "name": "h", "value": "window.innerHeight" },
            { "name": "extent", "value": "Math.min(window.innerWidth, window.innerHeight)" },
            { "name": "opacity", "value": "0.6" }
          ],
          "child": null
