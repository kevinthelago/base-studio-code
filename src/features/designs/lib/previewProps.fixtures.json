{
  "_note": "Cross-language parity fixture (#3165) for the preview-harness prop sampler. `previewProps(comp)` in componentPreview.ts (the TS source of truth) and `preview_props::preview_props_states` in crates/bsc-component (the `bsc components preview-props` verb) MUST both produce each case's `expected` (the golden). Each prop `value` is a JS-SOURCE literal/expression (what samplePropValue returns) — e.g. `() => {}`, `window.innerWidth`, or a JSON.stringify'd string like \"\\\"var(--accent)\\\"\" — NOT a JSON value. Asserted by componentPreview.test.ts (TS) and preview_props.rs (Rust). Edit both sides in lockstep. A case MAY carry `comp.source` — the component's own implementation, which is where the props it DEFAULTS are read from; a required container is omitted in loaded/loading only when that source defaults it, and supplied otherwise.",
  "cases": [
    {
      "desc": "chart with dimensions, an optional collection, a loading flag, a handler — the black-bars/NaN scenario",
      "comp": {
        "name": "Chart",
        "props": [
          { "name": "data", "type": "Row[]", "req": false },
          { "name": "width", "type": "number", "req": false },
          { "name": "height", "type": "number", "req": false },
          { "name": "loading", "type": "boolean", "req": false },
          { "name": "onSelect", "type": "(r) => void", "req": false }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "width", "value": "window.innerWidth" },
            { "name": "height", "value": "window.innerHeight" },
            { "name": "onSelect", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        },
        "empty": {
          "props": [
            { "name": "data", "value": "[]" },
            { "name": "width", "value": "window.innerWidth" },
            { "name": "height", "value": "window.innerHeight" },
            { "name": "onSelect", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        },
        "loading": {
          "props": [
            { "name": "width", "value": "window.innerWidth" },
            { "name": "height", "value": "window.innerHeight" },
            { "name": "loading", "value": "true" },
            { "name": "onSelect", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        }
      }
    },
