    {
      "desc": "the signature PARSER's hard shapes, pinned across both languages — a renamed binding with a default (`rows: list = DEMO`) is detected under its PROP name, a comma inside a string default does not split the segment, and an arrow default's parens/braces/comma do not break the walk. The two implementations are free to disagree on any shape no case reaches, which is how the error-family divergence survived.",
      "comp": {
        "name": "TrickySignature",
        "source": "export function TrickySignature({ rows: list = DEMO, cols, sep = \"a, b\", cb = (a, b) => ({ a }) }: Props) { return null; }",
        "props": [
          { "name": "rows", "type": "Row[]", "req": true },
          { "name": "cols", "type": "Col[]", "req": true },
          { "name": "sep", "type": "string", "req": true },
          { "name": "cb", "type": "(a, b) => void", "req": true }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "cols", "value": "[]" },
            { "name": "sep", "value": "\"Sep\"" },
            { "name": "cb", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        },
        "empty": {
          "props": [
            { "name": "rows", "value": "[]" },
            { "name": "cols", "value": "[]" },
            { "name": "sep", "value": "\"Sep\"" },
            { "name": "cb", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        },
        "loading": {
          "props": [
            { "name": "cols", "value": "[]" },
            { "name": "sep", "value": "\"Sep\"" },
            { "name": "cb", "value": "() => {}" }
          ],
          "child": null,
          "unsampled": []
        }
      }
    }
  ]
