      }
    },
    {
      "desc": "#84 the PaneMenu shape — required props typed by a NAMED ALIAS are reported as unsampled, while a loading-family, error-family or CONTAINER prop is not (each is governed by its own rule: the first two are state-driven, and the required container is supplied because this component declares no default for it)",
      "comp": {
        "name": "PaneMenu",
        "props": [
          { "name": "model", "type": "ModelId", "req": true },
          { "name": "active", "type": "ViewKey", "req": true },
          { "name": "available", "type": "ViewKey[]", "req": true },
          { "name": "vp", "type": "GraphViewport", "req": true },
          { "name": "tone", "type": "\"neutral\" | \"danger\"", "req": true },
          { "name": "loading", "type": "boolean", "req": true },
          { "name": "error", "type": "string", "req": true },
          { "name": "onPick", "type": "(v) => void", "req": true },
          { "name": "hint", "type": "AliasedButOptional", "req": false }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "available", "value": "[]" },
            { "name": "tone", "value": "\"neutral\"" },
            { "name": "onPick", "value": "() => {}" }
          ],
          "child": null,
