        "empty": {
          "props": [
            { "name": "onClick", "value": "() => {}" },
            { "name": "maxWidth", "value": "window.innerWidth" },
            { "name": "minHeight", "value": "window.innerHeight" },
            { "name": "w", "value": "window.innerWidth" },
            { "name": "h", "value": "window.innerHeight" },
            { "name": "extent", "value": "Math.min(window.innerWidth, window.innerHeight)" },
            { "name": "opacity", "value": "0.6" }
          ],
          "child": null
        },
        "loading": {
          "props": [
            { "name": "onClick", "value": "() => {}" },
            { "name": "maxWidth", "value": "window.innerWidth" },
            { "name": "minHeight", "value": "window.innerHeight" },
            { "name": "w", "value": "window.innerWidth" },
            { "name": "h", "value": "window.innerHeight" },
            { "name": "extent", "value": "Math.min(window.innerWidth, window.innerHeight)" },
            { "name": "opacity", "value": "0.6" }
          ],
          "child": null
        }
      }
    },
    {
      "desc": "#3693 data containers: Record<K,V>, Set<T>, Map<K,V> omit in loaded/loading (component default shows), typed-empty in empty — NEVER a title-cased string (langTotals as a string → Object.values NaN nonsense; highlight as a string → `.has()` crash)",
      "comp": {
        "name": "Insights",
        "props": [
          { "name": "langTotals", "type": "Record<string, number>", "req": true },
          { "name": "tags", "type": "Set<string>", "req": false },
          { "name": "byId", "type": "Map<string, number>", "req": false },
          { "name": "title", "type": "string", "req": false }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null
        },
        "empty": {
          "props": [
            { "name": "langTotals", "value": "{}" },
            { "name": "tags", "value": "new Set()" },
            { "name": "byId", "value": "new Map()" },
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null
        },
        "loading": {
          "props": [
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null
        }
      }
    },
    {
