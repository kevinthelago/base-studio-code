          "props": [
            { "name": "login", "value": "\"octocat\"" },
            { "name": "author", "value": "\"octocat\"" },
            { "name": "active", "value": "true" },
            { "name": "render", "value": "() => {}" }
          ],
          "child": null
        },
        "loading": {
          "props": [
            { "name": "login", "value": "\"octocat\"" },
            { "name": "author", "value": "\"octocat\"" },
            { "name": "active", "value": "true" },
            { "name": "render", "value": "() => {}" }
          ],
          "child": null
        }
      }
    },
