    {
      "desc": "#3693 data containers on a component that DEFAULTS them: Record<K,V>, Set<T>, Map<K,V> omit in loaded/loading (that default shows), typed-empty in empty — NEVER a title-cased string (langTotals as a string → Object.values NaN nonsense; highlight as a string → `.has()` crash)",
      "comp": {
        "name": "Insights",
        "source": "export function Insights({ langTotals = DEMO_LANGS, tags, byId, title }: Props) { return null; }",
        "props": [
          { "name": "langTotals", "type": "Record<string, number>", "req": true },
          { "name": "tags", "type": "Set<string>", "req": false },
          { "name": "byId", "type": "Map<string, number>", "req": false },
          { "name": "title", "type": "string", "req": false }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null,
          "unsampled": []
        },
        "empty": {
          "props": [
            { "name": "langTotals", "value": "{}" },
            { "name": "tags", "value": "new Set()" },
            { "name": "byId", "value": "new Map()" },
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null,
          "unsampled": []
        },
        "loading": {
          "props": [
            { "name": "title", "value": "\"Title\"" }
          ],
          "child": null,
          "unsampled": []
        }
      }
    },
