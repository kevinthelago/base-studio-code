          { "name": "tone", "type": "\"neutral\" | \"danger\"", "req": false },
          { "name": "count", "type": "number", "req": true }
        ]
      },
      "expected": {
        "loaded": {
          "props": [
            { "name": "label", "value": "\"Label\"" },
            { "name": "color", "value": "\"var(--accent)\"" },
            { "name": "tone", "value": "\"neutral\"" },
            { "name": "count", "value": "3" }
          ],
          "child": "\"Badge\"",
          "unsampled": []
        },
        "empty": {
          "props": [
            { "name": "label", "value": "\"Label\"" },
            { "name": "color", "value": "\"var(--accent)\"" },
            { "name": "tone", "value": "\"neutral\"" },
            { "name": "count", "value": "3" }
          ],
          "child": "\"Badge\"",
          "unsampled": []
        },
        "loading": {
          "props": [
            { "name": "label", "value": "\"Label\"" },
            { "name": "color", "value": "\"var(--accent)\"" },
            { "name": "tone", "value": "\"neutral\"" },
            { "name": "count", "value": "3" }
          ],
          "child": "\"Badge\"",
          "unsampled": []
        }
      }
    },
    {
      "desc": "loading-family (busy), fraction (progress), canvas size, style-dim (strokeWidth), required array the component DEFAULTS (#3693: omitted in loaded/loading so that default demo shows, [] only in empty)",
