    {
      "label": "a plain named import",
      "source": "import { X } from \"./x\";\n",
      "imports": [
        {
          "specifier": "./x",
          "symbols": [
            "X"
          ]
        }
      ]
    },
    {
      "label": "a default import",
      "source": "import React from \"react\";\n",
