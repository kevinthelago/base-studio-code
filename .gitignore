# Dependencies
node_modules/

# Build output. Vite emits to `target/dist` (`vite.config.ts` build.outDir, matched by
# `tauri.conf.json` frontendDist) — everything this build produces lives under `/target/`, which is
# ignored below. `dist-ssr/` is Vite's SSR default and this app has no SSR path; kept only because an
# accidental `vite build --ssr` should not offer to commit its output.
dist-ssr/

# Test coverage output
coverage/

# Playwright (opt-in e2e harness, #3264) — run artifacts + the downloaded browser's traces
test-results/
playwright-report/
blob-report/
.playwright/

# Tauri / Cargo build artifacts
/target/
src-tauri/target/
# `gen/` is the ONE build output still inside the source tree, and it stays there: tauri-build owns
# the path and exposes no knob to move it. Everything else this build used to drop in `src-tauri/` —
# the staged externalBin sidecars and the staged bundle resources — now lands in `target/sidecars/`
# and `target/bundle-resources/`, covered by `/target/` above (`epic-built-items-live-only-in-target`).
src-tauri/gen/

# Vite
*.local

# Logs
npm-debug.log*
.vite-dev.log

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code (local project state)
.claude/
# Per-worktree local instruction override (e.g. a lighter UI-tweak workflow) — never committed.
CLAUDE.local.md

# OS
.DS_Store
Thumbs.db

# Generated record cache — materialized from src-tauri/data seeds by scripts/emit-records.mjs
.bsc-records/

# THE KIT ARTIFACT IS DERIVED, not committed (`the-kit-artifact-is-derived-not-committed`).
#
# `react-ui.json` is 5.4 MB of GENERATED data whose home is now `graph/components.db`, and 619 of its
# 660 entries were verbatim copies of `.bsc-records/` — carrying, inside a committed file, the banner
# that says "do not commit". Its bytes were therefore a function of when a git-ignored cache was last
# materialized rather than of the commit: measured on ONE commit, the drift guard said "in sync" in one
# worktree and "3 runtime modules drifted" in another, minutes apart.
#
# Both files are materialized from the store by `bsc ui store import --apply`, which the gate runs, so
# every tree and every bundle still has them. The sidecar goes with the artifact: it is that artifact's
# hash, and committing a hash of something uncommitted is a promise nothing can keep.
src-tauri/data/components/react-ui.json
src-tauri/data/ui/react-ui-kit.meta.json

# Nested worktrees. The convention is `wt-<short>/` at the repo root (CLAUDE.md, "Parallel worktree
# agents"), which keeps them zero-install — and leaves every OTHER agent's worktree sitting in this one's
# `git status` as untracked. A `git add -A` in the main tree then stages them as EMBEDDED GIT REPOSITORIES,
# which is a confusing mess to unpick and easy to commit by accident. Ignoring the convention itself is
# cheaper than remembering not to.
wt-*/
# The detached worktree `npm run promote` gates in (scripts/promote-app.mjs).
.promote-gate/

# Editor / shell config that must never be tracked, and which tooling sandboxes
# materialise as empty files at the repo root. Left untracked they show up in
# `git status --porcelain`, which is what `npm run promote` reads to decide whether
# the app tree is dirty — so stray 0-byte dotfiles would block every promote.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.idea/
.idea
.vscode/
.vscode

# `bsc shot` captures. They belong in ~/.base-studio-code/shots/ (or $BSC_SHOT_DIR, or a studio
# session's confined <workspace>/shots/) and are never repo content — regenerable pixels, not source.
# Ten of them WERE committed once (src-tauri/flat.png + src-tauri/shots/, merge 6b52a96d): the app
# resolved a relative `out` against its own cwd, which is src-tauri/ under `tauri dev`. That hole is
# closed in shot::capture now, but the anchor was only ever the app's cwd by accident, so ignore the
# shape rather than the one path it happened to take.
shots/
/flat.png

# Crate manifests are GENERATED from `graph/manifests/` — the records are the source of truth
# (`a-crate-builds-and-tests-from-the-database`). Regenerate with `npm run emit:manifests`; the gate
# does it automatically, since a fresh `git worktree add` checks out only TRACKED files and would
# otherwise have no manifests at all.
/Cargo.toml
/src-tauri/Cargo.toml
/crates/*/Cargo.toml
