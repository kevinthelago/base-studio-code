# App-authored document templates are embedded verbatim via include_str! and
# written out as session CLAUDE.md / protocol files. Pin them to LF on every
# platform so the embedded content (and the generated files) are byte-identical
# regardless of where the build runs (#769).
src-tauri/templates/*.md text eol=lf

# Planner prose blocks embedded via include_dir! (config::load_str) and written
# verbatim into generated hub files (github_context.md / CLAUDE.md / automations.md).
# Pin to LF so the embedded bytes — and the generated files — stay byte-identical
# on every platform, matching the inline Rust literals they replaced (#2075 / #2027).
src-tauri/data/planner/github-commands.md   text eol=lf
src-tauri/data/planner/github-repo-item.md  text eol=lf
src-tauri/data/planner/linked-repo-item.md  text eol=lf
src-tauri/data/planner/automations-empty.md text eol=lf

# Externalized bsc-* shell rc fragments (#2092) + the bsc-defer directive (#2145), embedded via
# include_dir! (config::load_str) and concatenated into the session bsc-env.sh. MUST be LF: a CRLF
# checkout would embed `\r` into sourced bash (breaking the #296 one-function-per-line glue) and drift
# the assembled body from the rustc-normalized string literals these fragments replaced.
src-tauri/data/shell/*.sh          text eol=lf
src-tauri/data/fleet/*.md          text eol=lf

# Runtime-fault instrumentation adapters + per-stack shim templates (#2262), embedded via include_dir!
# and rendered verbatim into generated apps. Pin to LF so the rendered shim bytes are stable on every
# platform (a CRLF checkout would ship the generated app CRLF-laden shims).
src-tauri/data/runtime-fault/adapters.json  text eol=lf
src-tauri/data/runtime-fault/shims/*.tmpl   text eol=lf

# The packaged UI kit artifact + its hash sidecar (#2465). The sidecar records sha256(artifact
# bytes) and the Rust `bsc ui kit` store embeds BOTH via include_str! as the packaged fallback
# entry — pin to LF so the embedded bytes (and therefore the recorded hash) are identical on
# every platform. The artifact is (re)generated LF by reactUiKit.gen.test.ts.
src-tauri/data/components/react-ui.json  text eol=lf
src-tauri/data/ui/react-ui-kit.meta.json text eol=lf
# GENERATED from the shared-UI manifest (#3485) — pinned so the drift guard compares the same bytes on
# every platform, and so the Rust `include_str!` and the TS import see identical content.
src-tauri/data/ui/primitives.json        text eol=lf
# Hand-authored, but read by BOTH validators — pinned for the same reason.
src-tauri/data/ui/node-validation.fixtures.json text eol=lf

# The sounds twin (#3371): the packaged `signal` sound-kit seed + its hash sidecar. Same contract —
# the Rust `bsc sound release` store embeds BOTH via include_str! as the packaged fallback entry, so
# the seed's bytes ARE the pinned artifact and must be LF on every platform. The sidecar is
# (re)generated by signalKit.gen.test.ts; the seed itself is hand-authored data.
src-tauri/data/sounds/signal.json          text eol=lf
src-tauri/data/sound/signal-kit.meta.json  text eol=lf
