{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "base-studio-code",
  "version": "1.0.51",
  "identifier": "com.basestudio.code",
  "build": {
    "beforeDevCommand": "npm run build:plan && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run stage:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "base-studio-code",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#181a1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/bsc",
      "binaries/bsc-agent",
      "binaries/bsc-hook"
    ],
    "resources": {
      "resources/data/components/react-ui.json": "data/components/react-ui.json",
      "resources/data/deploy/taxonomy.json": "data/deploy/taxonomy.json",
      "resources/data/knowledge/algorithms.json": "data/knowledge/algorithms.json",
      "resources/data/market/rubric.json": "data/market/rubric.json",
      "resources/data/personas/architect.json": "data/personas/architect.json",
      "resources/data/personas/auditor.json": "data/personas/auditor.json",
      "resources/data/personas/curator.json": "data/personas/curator.json",
      "resources/data/personas/debugger.json": "data/personas/debugger.json",
      "resources/data/personas/designer.json": "data/personas/designer.json",
      "resources/data/personas/director.json": "data/personas/director.json",
      "resources/data/personas/documentor.json": "data/personas/documentor.json",
      "resources/data/personas/integrator.json": "data/personas/integrator.json",
      "resources/data/personas/issuer.json": "data/personas/issuer.json",
      "resources/data/personas/juror.json": "data/personas/juror.json",
      "resources/data/personas/librarian.json": "data/personas/librarian.json",
      "resources/data/personas/marketer.json": "data/personas/marketer.json",
      "resources/data/personas/planner.json": "data/personas/planner.json",
      "resources/data/personas/reviewer.json": "data/personas/reviewer.json",
      "resources/data/personas/sound-designer.json": "data/personas/sound-designer.json",
      "resources/data/personas/tester.json": "data/personas/tester.json",
      "resources/data/personas/triage.json": "data/personas/triage.json",
      "resources/data/personas/worker.json": "data/personas/worker.json",
      "resources/data/transformations/taxonomy.json": "data/transformations/taxonomy.json",
      "resources/data/ui/react-ui-kit.meta.json": "data/ui/react-ui-kit.meta.json"
    },
    "publisher": "base-studio-code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/bsc-path.nsh"
      }
    }
  }
}
