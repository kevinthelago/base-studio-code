{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "base-studio-code",
  "version": "1.0.51",
  "identifier": "com.basestudio.code",
  "build": {
    "beforeDevCommand": "npm run build:plan && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run stage:sidecar && npm run build",
    "frontendDist": "../target/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "base-studio-code",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#181a1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../target/sidecars/bsc",
      "../target/sidecars/bsc-agent",
      "../target/sidecars/bsc-hook"
    ],
    "resources": {
      "../target/bundle-resources/data/components/react-ui.json": "data/components/react-ui.json",
      "../target/bundle-resources/data/deploy/taxonomy.json": "data/deploy/taxonomy.json",
