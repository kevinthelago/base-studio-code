    { "id": "error", "name": "Error", "category": "notify", "layers": [{ "voice": "buzz", "at": 0 }] },
    { "id": "notify", "name": "Notify", "category": "notify",
      "layers": [{ "voice": "pop", "at": 0 }, { "voice": "sparkle", "at": 0.02 }] }
  ]
