  "cues": [
    { "id": "click", "name": "Click", "category": "ui", "layers": [{ "voice": "blip", "at": 0 }] },
    { "id": "toggle", "name": "Toggle", "category": "ui", "layers": [{ "voice": "tick", "at": 0 }] },
    { "id": "success", "name": "Success", "category": "notify",
