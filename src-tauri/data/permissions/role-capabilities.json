{
  "_comment": "The role→capability table for the session role gate (#219). Least-privilege per session type. The frontend loads this via sessionRoles.ts, which computes each session's permissions and passes them to the backend's ensure_session_settings — so this is the SINGLE source (Rust does not duplicate it). Externalized #2027 P1. github/git/code/net are access tiers (none|read|write); writeGlobs are the paths a role may write (empty = no code writes).",
  "roleDefaults": {
    "planner":   { "role": "planner",   "github": "read",  "git": "read",  "code": "write", "net": "read", "writeGlobs": ["*.md", "*.json", "prompts/*.md", "prompts/*", "discovery/*.md", "discovery/*"] },
    "worker":    { "role": "worker",    "github": "read",  "git": "write", "code": "write", "net": "read", "writeGlobs": [] },
    "director":  { "role": "director",  "github": "write", "git": "write", "code": "none",  "net": "read", "writeGlobs": [] },
    "triage":    { "role": "triage",    "github": "write", "git": "none",  "code": "none",  "net": "read", "writeGlobs": [] },
    "tester":    { "role": "tester",    "github": "read",  "git": "read",  "code": "none",  "net": "read", "writeGlobs": [] },
    "reviewer":  { "role": "reviewer",  "github": "read",  "git": "read",  "code": "none",  "net": "read", "writeGlobs": [] },
    "issuer":    { "role": "issuer",    "github": "write", "git": "read",  "code": "none",  "net": "read", "writeGlobs": [] },
    "juror":     { "role": "juror",     "github": "read",  "git": "read",  "code": "none",  "net": "read", "writeGlobs": [] },
    "documentor": { "role": "documentor", "github": "read", "git": "read", "code": "none", "net": "read", "writeGlobs": ["*.md", "**/*.md", "docs/**", "README*", "**/README*", "CHANGELOG*"] }
  },
  "dbOwnedPlanFiles": ["deploy.md", "deploy.json", "phases.json", "issues.json", "fleet.json", "repos.json", "features.json"],
  "depManifestFiles": ["package.json", "package-lock.json", "Cargo.toml", "Cargo.lock", "pnpm-lock.yaml", "yarn.lock"]
}
