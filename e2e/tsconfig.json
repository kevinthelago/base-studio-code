{
  // A SEPARATE tsconfig on purpose (#3264). The root `tsconfig.json` deliberately does NOT include
  // `e2e/`, because including it would make `npm run typecheck` — the gate every worktree agent runs —
  // hard-fail unless `@playwright/test` is physically installed. The zero-install nested-worktree
  // workflow (#1669) resolves deps from the shared repo-root `node_modules`, so a checkout that has not
  // re-run `npm install` since this landed would see the WHOLE gate break over an opt-in browser
  // harness. That is exactly the silent tax this harness must not become.
  //
  // The dir is still covered: `npm run lint` walks `.` and lints these files with the repo's normal
  // TS rules (no type information required), and `npm run typecheck:e2e` runs THIS config for anyone
  // who has installed the dep. Nothing here is unchecked-by-accident.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  // `../src/vite-env.d.ts` is pulled in because the harness imports app modules that rely on Vite's
  // ambient client types — the `?url` asset import in `componentBundle.ts` and the side-effect
  // `.css` import. Without it those resolve as "module not found" here even though Vite serves them.
  "include": ["../e2e", "../playwright.config.ts", "../src/vite-env.d.ts"]
}
